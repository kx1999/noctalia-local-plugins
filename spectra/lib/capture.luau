--!nonstrict
-- Audio capture through cava, shared by the desktop and bar entries.
--
-- Two modes:
--   "system": cava on the default output (or the configured source), as one
--             `exec cava` stream.
--   "player": only the shell's active MPRIS player. lib/capture.sh resolves
--             the player's PipeWire stream and runs cava on it alone; the
--             player's D-Bus name is handed to it through a small control
--             file that this module rewrites when the active player changes.
--             cava's frames pass through unchanged; lines starting with '#'
--             are status (see capture.sh).
--
-- Noctalia can't stop a stream from Luau (it kills the process group when
-- the widget goes away), so the supervisor runs for the widget's lifetime and
-- switches cava itself. Data lines go straight to `onLine` (the entry's frame
-- parser); the entry hands '#' lines to self.status and stamps
-- self.lastLineMs on every line.

local M = {}

local function shellQuote(s: string): string
  return "'" .. string.gsub(s, "'", "'\\''") .. "'"
end

local function hash(s: string): string
  local h1, h2 = 5381, 52711
  for i = 1, #s do
    local b = string.byte(s, i)
    h1 = (h1 * 33 + b) % 4294967296
    h2 = (h2 * 31 + b) % 4294967296
  end
  return string.format("%08x%08x", h1, h2)
end
M.hash = hash

-- o: host (nowMs, runStream, commandExists, fileExists, expandPath,
--    pluginDataDir, pluginDir, readFile, writeFile, mediaPlayer, tr, log),
--    mode, count, maxFps, cava = { path, method, source, noise, autosens,
--    lowCut, highCut }, onLine(line), setMessage(text?), label (for the log).
function M.new(o)
  local host = o.host
  local cava = o.cava or {}
  local cavaPath = if cava.path == nil or cava.path == "" then "cava" else cava.path
  local player = o.mode == "player"
  local self = {
    mode = if player then "player" else "system",
    lastLineMs = 0,
    streaming = false,
    target = nil, -- player mode: the captured stream's serial, or nil
    bus = nil, -- player mode: the D-Bus name last written to the control file
  }
  local startedAtMs = 0
  local lastStartMs = -1e9
  local ctlPath = nil
  local label = o.label or "spectra"

  local function message(text)
    if o.setMessage then
      o.setMessage(text)
    end
  end

  function self.configText(): string
    local source = if player or (cava.source or "") == "" then "auto" else cava.source
    local lowCut = cava.lowCut or 50
    local highCut = cava.highCut or 10000
    return table.concat({
      "; generated by the kylex/spectra Noctalia plugin",
      "[general]",
      "bars = " .. o.count,
      "framerate = " .. math.floor(math.min(o.maxFps, 200)),
      "autosens = " .. (if cava.autosens ~= false then 1 else 0),
      "sensitivity = 100",
      "lower_cutoff_freq = " .. math.floor(lowCut),
      "higher_cutoff_freq = " .. math.floor(math.max(highCut, lowCut * 2)),
      "sleep_timer = 0",
      "[input]",
      -- Targeting one playback stream needs PipeWire.
      "method = " .. (if player then "pipewire" else (cava.method or "pipewire")),
      "source = " .. source,
      "[output]",
      "method = raw",
      "raw_target = /dev/stdout",
      "data_format = ascii",
      "ascii_max_range = 1000",
      "bar_delimiter = 59",
      "frame_delimiter = 10",
      "channels = mono",
      "mono_option = average",
      "[smoothing]",
      "noise_reduction = " .. math.floor(cava.noise or 70),
      "monstercat = 0",
      "waves = 0",
      "",
    }, "\n")
  end

  -- Write the player to follow (player mode); a no-op when unchanged.
  local function follow(bus: string)
    if bus == self.bus or ctlPath == nil then
      return
    end
    self.bus = bus
    local ok, err = host.writeFile(ctlPath, bus .. "\n")
    if not ok then
      host.log(label .. ": capture control file: " .. tostring(err))
    end
  end

  function self.start()
    lastStartMs = host.nowMs()
    local isPath = string.find(cavaPath, "/", 1, true) ~= nil
    local exe = if isPath then host.expandPath(cavaPath) else cavaPath
    local exists = if isPath then host.fileExists(exe) else host.commandExists(cavaPath)
    if not exists then
      message(host.tr("desktop.cava_missing", { path = cavaPath }))
      return false
    end
    local dir, err = host.pluginDataDir()
    if dir == nil then
      message("pluginDataDir: " .. tostring(err))
      return false
    end
    local conf = self.configText()
    local path = dir .. "/cava-" .. hash(conf) .. ".conf"
    if host.readFile(path) ~= conf then
      local ok, werr = host.writeFile(path, conf)
      if not ok then
        message("cava config: " .. tostring(werr))
        return false
      end
    end
    local cmd
    if player then
      local pluginDir = host.pluginDir()
      if pluginDir == nil or not host.commandExists("bash") then
        message(host.tr("desktop.cava_failed"))
        return false
      end
      -- One control file per supervisor (instances and restarts never share).
      ctlPath = string.format("%s/capture-%s-%d.ctl", dir, hash(conf), math.floor(lastStartMs) % 1000000000)
      self.bus = nil
      local current = host.mediaPlayer()
      follow(if current ~= nil then current.busName or "" else "")
      cmd = "exec bash "
        .. shellQuote(pluginDir .. "/lib/capture.sh")
        .. " "
        .. shellQuote(ctlPath)
        .. " "
        .. shellQuote(exe)
        .. " "
        .. shellQuote(path)
    else
      cmd = "exec " .. shellQuote(exe) .. " -p " .. shellQuote(path) .. " 2>/dev/null"
    end
    self.streaming = host.runStream(cmd, o.onLine)
    if self.streaming then
      startedAtMs = lastStartMs
      self.lastLineMs = lastStartMs
      message(nil)
    else
      message(host.tr("desktop.cava_failed"))
    end
    return self.streaming
  end

  -- A '#' status line from capture.sh.
  function self.status(line: string)
    if string.sub(line, 1, 7) == "#target" then
      local serial = string.match(line, "^#target (%S+)")
      if serial ~= self.target then
        self.target = serial
        host.log(label .. ": capturing the active player's audio (stream " .. tostring(serial) .. ")")
      end
    elseif string.sub(line, 1, 5) == "#none" then
      if self.target ~= nil then
        host.log(label .. ": the active player has no audio stream; showing silence")
      end
      self.target = nil
    end
  end

  -- Player mode: follow the active player (noctalia.mediaPlayer(), nil when
  -- there is none). The entry polls it a few times a second.
  function self.follow(current)
    if player and self.streaming then
      follow(if current ~= nil then current.busName or "" else "")
    end
  end

  -- Called from the entry's update(): restarts a dead capture. Returns true
  -- while frames are arriving.
  function self.update(now: number)
    local fed = self.streaming and now - self.lastLineMs < 250
    if not fed and now - lastStartMs > 5000 then
      -- The system stream is silent only when cava died; the supervisor
      -- sends a heartbeat every 5 s even without a player.
      local quiet = now - math.max(self.lastLineMs, startedAtMs)
      if not self.streaming or quiet > (if player then 12000 else 4000) then
        self.start()
      end
    end
    -- In player mode, frames only arrive while a stream is captured.
    return fed and (not player or self.target ~= nil)
  end

  return self
end

return M
